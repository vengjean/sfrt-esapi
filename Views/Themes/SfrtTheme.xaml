<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ════════════════════════════════════════════════════
         Color tokens (mirrors sfrt-ui.jsx:4-24)
         ════════════════════════════════════════════════════ -->
    <Color x:Key="SfrtBgColor">#FF0D1218</Color>
    <Color x:Key="SfrtSurface0Color">#FF141A23</Color>
    <Color x:Key="SfrtSurface1Color">#FF1A2330</Color>
    <Color x:Key="SfrtSurface2Color">#FF222D3D</Color>
    <Color x:Key="SfrtSurface3Color">#FF2A3648</Color>
    <Color x:Key="SfrtBorderLoColor">#FF222D3D</Color>
    <Color x:Key="SfrtBorderHiColor">#FF34425A</Color>
    <Color x:Key="SfrtTextColor">#FFE7ECF3</Color>
    <Color x:Key="SfrtTextMidColor">#FFAAB4C2</Color>
    <Color x:Key="SfrtTextDimColor">#FF7B8595</Color>
    <Color x:Key="SfrtTextFaintColor">#FF5A6373</Color>
    <Color x:Key="SfrtAccentColor">#FF3B82F6</Color>
    <Color x:Key="SfrtAccentHiColor">#FF60A5FA</Color>
    <Color x:Key="SfrtAccentLoColor">#FF1D4ED8</Color>
    <Color x:Key="SfrtAccentSoftColor">#293B82F6</Color>
    <Color x:Key="SfrtAccentTintColor">#143B82F6</Color>
    <Color x:Key="SfrtOkColor">#FF22C55E</Color>
    <Color x:Key="SfrtWarnColor">#FFF59E0B</Color>
    <Color x:Key="SfrtErrColor">#FFEF4444</Color>
    <Color x:Key="SfrtScrimColor">#8C080C12</Color>

    <SolidColorBrush x:Key="SfrtBg" Color="{StaticResource SfrtBgColor}"/>
    <SolidColorBrush x:Key="SfrtSurface0" Color="{StaticResource SfrtSurface0Color}"/>
    <SolidColorBrush x:Key="SfrtSurface1" Color="{StaticResource SfrtSurface1Color}"/>
    <SolidColorBrush x:Key="SfrtSurface2" Color="{StaticResource SfrtSurface2Color}"/>
    <SolidColorBrush x:Key="SfrtSurface3" Color="{StaticResource SfrtSurface3Color}"/>
    <SolidColorBrush x:Key="SfrtBorderLo" Color="{StaticResource SfrtBorderLoColor}"/>
    <SolidColorBrush x:Key="SfrtBorderHi" Color="{StaticResource SfrtBorderHiColor}"/>
    <SolidColorBrush x:Key="SfrtText" Color="{StaticResource SfrtTextColor}"/>
    <SolidColorBrush x:Key="SfrtTextMid" Color="{StaticResource SfrtTextMidColor}"/>
    <SolidColorBrush x:Key="SfrtTextDim" Color="{StaticResource SfrtTextDimColor}"/>
    <SolidColorBrush x:Key="SfrtTextFaint" Color="{StaticResource SfrtTextFaintColor}"/>
    <SolidColorBrush x:Key="SfrtAccent" Color="{StaticResource SfrtAccentColor}"/>
    <SolidColorBrush x:Key="SfrtAccentHi" Color="{StaticResource SfrtAccentHiColor}"/>
    <SolidColorBrush x:Key="SfrtAccentLo" Color="{StaticResource SfrtAccentLoColor}"/>
    <SolidColorBrush x:Key="SfrtAccentSoft" Color="{StaticResource SfrtAccentSoftColor}"/>
    <SolidColorBrush x:Key="SfrtAccentTint" Color="{StaticResource SfrtAccentTintColor}"/>
    <SolidColorBrush x:Key="SfrtOk" Color="{StaticResource SfrtOkColor}"/>
    <SolidColorBrush x:Key="SfrtWarn" Color="{StaticResource SfrtWarnColor}"/>
    <SolidColorBrush x:Key="SfrtErr" Color="{StaticResource SfrtErrColor}"/>
    <SolidColorBrush x:Key="SfrtScrim" Color="{StaticResource SfrtScrimColor}"/>

    <FontFamily x:Key="SfrtFont">Inter, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="SfrtMono">JetBrains Mono, Consolas, Courier New</FontFamily>

    <!-- ════════════════════════════════════════════════════
         Icon geometries  (from sfrt-ui.jsx:329-351)
         ════════════════════════════════════════════════════ -->
    <Geometry x:Key="IconPlus">M 7 2.5 L 7 11.5 M 2.5 7 L 11.5 7</Geometry>
    <Geometry x:Key="IconMinus">M 2.5 7 L 11.5 7</Geometry>
    <Geometry x:Key="IconX">M 3 3 L 9 9 M 9 3 L 3 9</Geometry>
    <Geometry x:Key="IconChevron">M 4.5 2.5 L 8 6 L 4.5 9.5</Geometry>
    <Geometry x:Key="IconSliders">M 2 3 L 8 3 M 11 3 L 12 3 M 2 7 L 4 7 M 7 7 L 12 7 M 2 11 L 9 11 M 11 11 L 12 11</Geometry>
    <Geometry x:Key="IconEye">M 1 7 C 3 3 5 3 7 3 C 9 3 11 3 13 7 C 11 11 9 11 7 11 C 5 11 3 11 1 7 Z M 7 5.3 A 1.7 1.7 0 1 1 7 8.7 A 1.7 1.7 0 1 1 7 5.3 Z</Geometry>
    <Geometry x:Key="IconEyeOff">M 1 7 C 3 3 5 3 7 3 C 8 3 9 3.2 9.7 3.7 M 13 7 C 11 11 9 11 7 11 C 6 11 5 10.8 4.3 10.3 M 2 2 L 12 12</Geometry>
    <Geometry x:Key="IconRefresh">M 2 7 A 5 5 0 0 1 11 4 M 12 7 A 5 5 0 0 1 3 10 M 11 2 L 11 4.5 L 8.5 4.5 M 3 12 L 3 9.5 L 5.5 9.5</Geometry>
    <Geometry x:Key="IconPlay">M 3 2 L 11 6.5 L 3 11 Z</Geometry>
    <Geometry x:Key="IconCheck">M 2.5 6.5 L 5 9 L 9.5 3.5</Geometry>
    <Geometry x:Key="IconTarget">M 7 1.5 A 5.5 5.5 0 1 1 7 12.5 A 5.5 5.5 0 1 1 7 1.5 Z M 7 4 A 3 3 0 1 1 7 10 A 3 3 0 1 1 7 4 Z</Geometry>
    <Geometry x:Key="IconInfo">M 7 1.5 A 5.5 5.5 0 1 1 7 12.5 A 5.5 5.5 0 1 1 7 1.5 Z M 7 6 L 7 10 M 7 4 L 7 4.5</Geometry>
    <Geometry x:Key="IconSphere">M 7 1.5 A 5.5 5.5 0 1 1 7 12.5 A 5.5 5.5 0 1 1 7 1.5 Z M 1.5 7 A 5.5 2.2 0 1 1 12.5 7 A 5.5 2.2 0 1 1 1.5 7 Z M 7 1.5 A 2.2 5.5 0 1 1 7 12.5 A 2.2 5.5 0 1 1 7 1.5 Z</Geometry>
    <Geometry x:Key="IconShield">M 7 1.5 L 12 3.5 L 12 7 C 12 10 9.8 12 7 12.5 C 4.2 12 2 10 2 7 L 2 3.5 Z</Geometry>

    <!-- ════════════════════════════════════════════════════
         Base TextBlock + UserControl/Window defaults
         ════════════════════════════════════════════════════ -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SfrtText}"/>
        <Setter Property="FontFamily" Value="{StaticResource SfrtFont}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- Section header label (uppercase, dim) -->
    <Style x:Key="SfrtFieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SfrtTextDim}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="SfrtGroupLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SfrtTextDim}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="SfrtSectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SfrtText}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SfrtSectionSub" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource SfrtTextDim}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- ════════════════════════════════════════════════════
         Section card  ▸  Border with header + body
         ════════════════════════════════════════════════════ -->
    <Style x:Key="SfrtSection" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SfrtSurface1}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SfrtBorderLo}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="ClipToBounds" Value="True"/>
    </Style>

    <Style x:Key="SfrtSectionHeader" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource SfrtBorderLo}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="18,12"/>
    </Style>

    <Style x:Key="SfrtSectionBody" TargetType="Border">
        <Setter Property="Padding" Value="18,14,18,16"/>
    </Style>

    <!-- ════════════════════════════════════════════════════
         Pill
         ════════════════════════════════════════════════════ -->
    <Style x:Key="SfrtPillNeutral" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SfrtSurface2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SfrtBorderHi}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="10,2"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SfrtPillAccent" TargetType="Border" BasedOn="{StaticResource SfrtPillNeutral}">
        <Setter Property="Background" Value="{StaticResource SfrtAccentSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SfrtAccent}"/>
    </Style>
    <Style x:Key="SfrtPillOk" TargetType="Border" BasedOn="{StaticResource SfrtPillNeutral}">
        <Setter Property="Background" Value="#1A22C55E"/>
        <Setter Property="BorderBrush" Value="#4D22C55E"/>
    </Style>

    <Style x:Key="SfrtPillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource SfrtTextMid}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SfrtPillTextAccent" TargetType="TextBlock" BasedOn="{StaticResource SfrtPillText}">
        <Setter Property="Foreground" Value="{StaticResource SfrtAccentHi}"/>
    </Style>
    <Style x:Key="SfrtPillTextOk" TargetType="TextBlock" BasedOn="{StaticResource SfrtPillText}">
        <Setter Property="Foreground" Value="{StaticResource SfrtOk}"/>
    </Style>

    <!-- ════════════════════════════════════════════════════
         Button styles
         ════════════════════════════════════════════════════ -->
    <Style x:Key="SfrtButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource SfrtFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SfrtPrimaryButton" TargetType="Button" BasedOn="{StaticResource SfrtButtonBase}">
        <Setter Property="Background" Value="{StaticResource SfrtAccent}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SfrtAccent}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="SfrtSecondaryButton" TargetType="Button" BasedOn="{StaticResource SfrtButtonBase}">
        <Setter Property="Background" Value="{StaticResource SfrtSurface2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SfrtBorderHi}"/>
        <Setter Property="Foreground" Value="{StaticResource SfrtText}"/>
    </Style>

    <Style x:Key="SfrtGhostButton" TargetType="Button" BasedOn="{StaticResource SfrtButtonBase}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource SfrtBorderLo}"/>
        <Setter Property="Foreground" Value="{StaticResource SfrtTextMid}"/>
    </Style>

    <Style x:Key="SfrtIconButton" TargetType="Button" BasedOn="{StaticResource SfrtGhostButton}">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource SfrtBorderLo}"/>
        <Setter Property="Foreground" Value="{StaticResource SfrtTextDim}"/>
    </Style>

    <!-- ════════════════════════════════════════════════════
         TextBox  (dark surface, accent focus border)
         ════════════════════════════════════════════════════ -->
    <Style x:Key="SfrtTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource SfrtFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource SfrtText}"/>
        <Setter Property="Background" Value="{StaticResource SfrtSurface2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SfrtBorderHi}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource SfrtAccentHi}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource SfrtAccent}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource SfrtAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════
         ComboBox  (dark)
         ════════════════════════════════════════════════════ -->
    <Style x:Key="SfrtComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource SfrtText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="6"
                            Margin="2,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SfrtAccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="SfrtComboBoxTemplate" TargetType="ComboBox">
        <Grid>
            <ToggleButton x:Name="ToggleButton"
                          ClickMode="Press"
                          Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"/>
                                <Path Grid.Column="1"
                                      Data="{StaticResource IconChevron}"
                                      Stroke="{StaticResource SfrtTextDim}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Width="12" Height="12"
                                      RenderTransformOrigin="0.5,0.5"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="90"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </ToggleButton.Template>
                <ToggleButton.Background>
                    <SolidColorBrush Color="{StaticResource SfrtSurface2Color}"/>
                </ToggleButton.Background>
                <ToggleButton.BorderBrush>
                    <SolidColorBrush Color="{StaticResource SfrtBorderHiColor}"/>
                </ToggleButton.BorderBrush>
            </ToggleButton>
            <ContentPresenter x:Name="ContentSite"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              IsHitTestVisible="False"
                              Margin="14,0,32,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"/>
            <Popup x:Name="PART_Popup"
                   AllowsTransparency="True"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Placement="Bottom"
                   PopupAnimation="Slide">
                <Border Margin="0,6,0,0"
                        Background="{StaticResource SfrtSurface2}"
                        BorderBrush="{StaticResource SfrtBorderHi}"
                        BorderThickness="1"
                        CornerRadius="10"
                        MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="240">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45"/>
                    </Border.Effect>
                    <ScrollViewer Margin="6" Padding="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel IsItemsHost="True"/>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
    </ControlTemplate>

    <Style x:Key="SfrtComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource SfrtFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource SfrtText}"/>
        <Setter Property="Background" Value="{StaticResource SfrtSurface2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource SfrtBorderHi}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SfrtComboBoxItem}"/>
        <Setter Property="Template" Value="{StaticResource SfrtComboBoxTemplate}"/>
    </Style>

    <!-- ════════════════════════════════════════════════════
         CheckBox  (square + checkmark)
         ════════════════════════════════════════════════════ -->
    <Style x:Key="SfrtCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource SfrtText}"/>
        <Setter Property="FontFamily" Value="{StaticResource SfrtFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box"
                                Width="18" Height="18"
                                CornerRadius="5"
                                Background="{StaticResource SfrtSurface2}"
                                BorderBrush="{StaticResource SfrtBorderHi}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Path x:Name="Tick"
                                  Data="{StaticResource IconCheck}"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="12" Height="12"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource SfrtAccent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource SfrtAccent}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════
         Toggle switch  (ToggleButton restyled as pill)
         ════════════════════════════════════════════════════ -->
    <Style x:Key="SfrtSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track"
                                CornerRadius="10"
                                Background="{StaticResource SfrtSurface3}"/>
                        <Ellipse x:Name="Thumb"
                                 Width="16" Height="16"
                                 Fill="White"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Margin="2,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource SfrtAccent}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle card  ▸  switch + label, with selected highlight -->
    <Style x:Key="SfrtToggleCard" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Card"
                            CornerRadius="8"
                            Background="{StaticResource SfrtSurface1}"
                            BorderBrush="{StaticResource SfrtBorderLo}"
                            BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource SfrtAccentTint}"/>
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource SfrtAccentLo}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════
         Slider  (dark track, accent fill, white thumb)
         ════════════════════════════════════════════════════ -->
    <Style x:Key="SfrtRepeatButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SfrtThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse Fill="{StaticResource SfrtAccent}"/>
                        <Ellipse Width="8" Height="8" Fill="White"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SfrtSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource SfrtAccent}"/>
        <Setter Property="Background" Value="{StaticResource SfrtSurface2}"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"/>
                        <Track x:Name="PART_Track" Grid.Row="0">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SfrtRepeatButton}" Command="{x:Static Slider.DecreaseLarge}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SfrtThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SfrtRepeatButton}" Command="{x:Static Slider.IncreaseLarge}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ════════════════════════════════════════════════════
         ScrollBar (dark, thin, matches slider feel)
         ════════════════════════════════════════════════════ -->
    <Style x:Key="SfrtScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBd"
                            CornerRadius="4"
                            Margin="2"
                            Background="{StaticResource SfrtSurface3}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource SfrtBorderHi}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource SfrtAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SfrtScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="SfrtVerticalScrollBar" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Border Background="{StaticResource SfrtSurface0}" Width="8" HorizontalAlignment="Center" CornerRadius="4" Opacity="0.4"/>
            <Track Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SfrtScrollBarPageButton}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SfrtScrollBarThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SfrtScrollBarPageButton}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="SfrtHorizontalScrollBar" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Border Background="{StaticResource SfrtSurface0}" Height="8" VerticalAlignment="Center" CornerRadius="4" Opacity="0.4"/>
            <Track Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SfrtScrollBarPageButton}" Command="{x:Static ScrollBar.PageLeftCommand}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource SfrtScrollBarThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource SfrtScrollBarPageButton}" Command="{x:Static ScrollBar.PageRightCommand}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="12"/>
                <Setter Property="MinWidth" Value="12"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Template" Value="{StaticResource SfrtVerticalScrollBar}"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template" Value="{StaticResource SfrtHorizontalScrollBar}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ════════════════════════════════════════════════════
         ListBox (dark)
         ════════════════════════════════════════════════════ -->
    <Style x:Key="SfrtListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource SfrtText}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            Margin="0,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SfrtAccentTint}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SfrtAccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SfrtListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource SfrtText}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource SfrtListBoxItem}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <!-- A ListBox draws its chrome (border + ScrollViewer + ItemsPresenter)
             from the OS theme dll, so on a bad Citrix theme bind the list renders
             blank even though the items are bound. An explicit, theme-independent
             template fixes that. ItemsPanel / ItemContainerStyle / ScrollViewer.*
             attached settings are preserved via TemplateBindings. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Focusable="False"
                                      Padding="{TemplateBinding Padding}"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
