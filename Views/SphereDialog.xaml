<UserControl x:Class="SFRT_PlanningScript.Views.SphereDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SFRT_PlanningScript.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:media3D="http://schemas.microsoft.com/netfx/2007/xaml/presentation"
             mc:Ignorable="d"
             Background="{DynamicResource SfrtBg}"
             FontFamily="{DynamicResource SfrtFont}"
             TextElement.Foreground="{DynamicResource SfrtText}"
             d:DesignWidth="1500"
             d:DesignHeight="1050">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SfrtTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Background="{StaticResource SfrtBg}">

        <DockPanel LastChildFill="True">

            <!-- ═══════════════════════════════════════════════════════════
                 HEADER BAR
                 ═══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Top"
                    Height="56"
                    Background="{StaticResource SfrtSurface0}"
                    BorderBrush="{StaticResource SfrtBorderLo}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo tile -->
                    <Border Grid.Column="0"
                            Width="32"
                            Height="32"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0"
                                                 EndPoint="1,1">
                                <GradientStop Color="{StaticResource SfrtAccentColor}"
                                              Offset="0"/>
                                <GradientStop Color="{StaticResource SfrtAccentLoColor}"
                                              Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="{StaticResource IconSphere}"
                              Stroke="White"
                              StrokeThickness="1.3"
                              Fill="Transparent"
                              Width="16"
                              Height="16"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Title block -->
                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="SFRT Planning"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SfrtText}"/>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Grid.Column="2"
                            Width="1"
                            Height="28"
                            Background="{StaticResource SfrtBorderLo}"
                            Margin="18,0,18,0"
                            VerticalAlignment="Center"/>

                    <!-- Pills -->
                    <Border Grid.Column="3"
                            Style="{StaticResource SfrtPillNeutral}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding PatientLabel, FallbackValue=Patient, TargetNullValue=Patient}"
                                   Style="{StaticResource SfrtPillText}"/>
                    </Border>
                    <Border Grid.Column="4"
                            Style="{StaticResource SfrtPillAccent}"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding PlanLabel, FallbackValue=Plan, TargetNullValue=Plan}"
                                   Style="{StaticResource SfrtPillTextAccent}"/>
                    </Border>

                    <!-- Show 3D preview button (only when preview hidden) -->
                    <Button x:Name="ShowPreviewBtn"
                            Grid.Column="6"
                            Style="{StaticResource SfrtSecondaryButton}"
                            Height="34"
                            Padding="14,0"
                            VerticalAlignment="Center"
                            Visibility="Visible"
                            Click="ShowPreview_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconEye}"
                                  Stroke="{StaticResource SfrtText}"
                                  StrokeThickness="1.3"
                                  Fill="Transparent"
                                  Width="14"
                                  Height="14"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Show 3D preview"
                                       Margin="8,0,8,0"
                                       VerticalAlignment="Center"/>
                            <Path Data="{StaticResource IconChevron}"
                                  Stroke="{StaticResource SfrtText}"
                                  StrokeThickness="1.5"
                                  Fill="Transparent"
                                  Width="10"
                                  Height="10"
                                  VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="180"/>
                                </Path.RenderTransform>
                            </Path>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 BOTTOM ACTION BAR
                 ═══════════════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom"
                    Margin="28,0,28,16"
                    Background="{StaticResource SfrtSurface1}"
                    BorderBrush="{StaticResource SfrtBorderLo}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Style="{StaticResource SfrtPillOk}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6"
                                     Height="6"
                                     Fill="{StaticResource SfrtOk}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="Ready"
                                       Style="{StaticResource SfrtPillTextOk}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Margin="14,0,0,0"
                               Foreground="{StaticResource SfrtTextMid}"
                               FontFamily="{StaticResource SfrtMono}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Text="{Binding StatusMessage, FallbackValue=Ready, TargetNullValue=Ready}"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource SfrtGhostButton}"
                            Height="36"
                            Padding="12,0"
                            Margin="10,0,0,0"
                            Click="OpenLogDrawer_Click"
                            ToolTip="Show full log output">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconInfo}"
                                  Stroke="{StaticResource SfrtTextMid}"
                                  StrokeThickness="1.3"
                                  Fill="Transparent"
                                  Width="14"
                                  Height="14"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="View logs"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="3"
                            Style="{StaticResource SfrtPrimaryButton}"
                            Height="44"
                            Padding="22,0"
                            Margin="12,0,0,0"
                            Click="CreateLattice"
                            IsEnabled="{Binding EnableCreate}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPlay}"
                                  Fill="White"
                                  Width="12"
                                  Height="12"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Create structures"
                                       Margin="8,0,0,0"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4"
                            Style="{StaticResource SfrtGhostButton}"
                            Margin="10,0,0,0"
                            Click="Optimize"
                            IsEnabled="{Binding EnableOptimize}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTarget}"
                                  Stroke="{StaticResource SfrtTextMid}"
                                  StrokeThickness="1.3"
                                  Fill="Transparent"
                                  Width="14"
                                  Height="14"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="Set objectives"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════════════════════
                 MAIN + PREVIEW area
                 ═══════════════════════════════════════════════════════════ -->
            <Grid x:Name="MainPreviewGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="PreviewColumn"
                                      Width="0"/>
                </Grid.ColumnDefinitions>

                <!-- ─── LEFT: stacked sections (scrollable) ────────────── -->
                <ScrollViewer Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="28,14,20,0"
                              Background="{StaticResource SfrtBg}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- ════ Targets & body ════ -->
                        <Border Grid.Row="0"
                                Style="{StaticResource SfrtSection}">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Top"
                                        Style="{StaticResource SfrtSectionHeader}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Targets &amp; body"
                                                       Style="{StaticResource SfrtSectionTitle}"/>
                                            <TextBlock Text="Reference structures and body envelope"
                                                       Style="{StaticResource SfrtSectionSub}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="High resolution"
                                                       FontSize="12"
                                                       Foreground="{StaticResource SfrtTextDim}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <ToggleButton Style="{StaticResource SfrtSwitch}"
                                                          IsChecked="{Binding HighRes}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SfrtSectionBody}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,8,0">
                                            <TextBlock Text="GTV"
                                                       Style="{StaticResource SfrtFieldLabel}"/>
                                            <ComboBox x:Name="TargetList"
                                                      Style="{StaticResource SfrtComboBox}"
                                                      ItemsSource="{Binding TargetStructures}"
                                                      SelectedIndex="{Binding TargetSelected}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Margin="4,0,4,0">
                                            <TextBlock Text="PTV_Low"
                                                       Style="{StaticResource SfrtFieldLabel}"/>
                                            <ComboBox x:Name="PtvList"
                                                      Style="{StaticResource SfrtComboBox}"
                                                      ItemsSource="{Binding TargetStructures}"
                                                      SelectedIndex="{Binding PtvSelected}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    Margin="4,0,4,0">
                                            <TextBlock Text="Body contour"
                                                       Style="{StaticResource SfrtFieldLabel}"/>
                                            <ComboBox x:Name="BodyContour"
                                                      Style="{StaticResource SfrtComboBox}"
                                                      ItemsSource="{Binding AllStructures}"
                                                      SelectedIndex="{Binding BodySelected}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3"
                                                    Margin="8,0,0,0">
                                            <TextBlock Text="Body margin (mm)"
                                                       Style="{StaticResource SfrtFieldLabel}"/>
                                            <TextBox x:Name="BodyMargin"
                                                     Style="{StaticResource SfrtTextBox}"
                                                     Text="{Binding BodyMargin}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- ════ OARs ════ -->
                        <Border Grid.Row="1"
                                Style="{StaticResource SfrtSection}"
                                Margin="0,12,0,0"
                                ClipToBounds="False">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Top"
                                        Style="{StaticResource SfrtSectionHeader}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Organs at risk"
                                                       Style="{StaticResource SfrtSectionTitle}"/>
                                            <TextBlock Text="Minimum margin enforced between hot spheres and each selected OAR"
                                                       Style="{StaticResource SfrtSectionSub}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Style="{StaticResource SfrtPillNeutral}"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource SfrtPillText}">
                                                <Run Text="{Binding SelectedOars.Count, Mode=OneWay}"/>
                                                <Run Text=" selected"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SfrtSectionBody}">
                                    <StackPanel>
                                        <!-- Fixed-height scrollable list (≈3 rows × 3 cols) -->
                                        <Border Height="200"
                                                CornerRadius="10"
                                                BorderBrush="{StaticResource SfrtBorderLo}"
                                                BorderThickness="1"
                                                Background="#06000000">
                                            <ListBox x:Name="OarChipsList"
                                                     Style="{StaticResource SfrtListBox}"
                                                     ItemsSource="{Binding SelectedOars}"
                                                     Background="Transparent"
                                                     Padding="8"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <UniformGrid Columns="3"/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding"
                                                                Value="4"/>
                                                        <Setter Property="Background"
                                                                Value="Transparent"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource SfrtSurface2}"
                                                                BorderBrush="{StaticResource SfrtBorderLo}"
                                                                BorderThickness="1"
                                                                CornerRadius="10"
                                                                Padding="10,8">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Row="0"
                                                                        Grid.Column="0"
                                                                        Width="24"
                                                                        Height="24"
                                                                        CornerRadius="6"
                                                                        Background="{StaticResource SfrtAccentTint}"
                                                                        VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource IconShield}"
                                                                          Stroke="{StaticResource SfrtAccentHi}"
                                                                          StrokeThickness="1.3"
                                                                          Fill="Transparent"
                                                                          Width="14"
                                                                          Height="14"
                                                                          VerticalAlignment="Center"
                                                                          HorizontalAlignment="Center"/>
                                                                </Border>

                                                                <TextBlock Grid.Row="0"
                                                                           Grid.Column="1"
                                                                           Margin="10,0,0,0"
                                                                           VerticalAlignment="Center"
                                                                           Text="{Binding Name}"
                                                                           Foreground="{StaticResource SfrtText}"
                                                                           FontSize="13"
                                                                           FontWeight="Medium"
                                                                           TextTrimming="CharacterEllipsis"/>

                                                                <Button Grid.Row="0"
                                                                        Grid.Column="2"
                                                                        Style="{StaticResource SfrtIconButton}"
                                                                        Tag="{Binding}"
                                                                        Click="RemoveOarChip_Click">
                                                                    <Path Data="{StaticResource IconX}"
                                                                          Stroke="{StaticResource SfrtTextDim}"
                                                                          StrokeThickness="1.5"
                                                                          Fill="Transparent"
                                                                          Width="10"
                                                                          Height="10"
                                                                          StrokeStartLineCap="Round"
                                                                          StrokeEndLineCap="Round"/>
                                                                </Button>

                                                                <StackPanel Grid.Row="1"
                                                                            Grid.Column="0"
                                                                            Grid.ColumnSpan="3"
                                                                            Orientation="Horizontal"
                                                                            Margin="0,6,0,0"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="Margin"
                                                                               Foreground="{StaticResource SfrtTextDim}"
                                                                               FontSize="11"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,6,0"/>
                                                                    <TextBox Style="{StaticResource SfrtTextBox}"
                                                                             Width="56"
                                                                             Height="26"
                                                                             Padding="6,0"
                                                                             FontSize="12"
                                                                             ToolTip="Per-OAR margin (mm)"
                                                                             Text="{Binding Margin, UpdateSourceTrigger=LostFocus}"/>
                                                                    <TextBlock Text="mm"
                                                                               Foreground="{StaticResource SfrtTextDim}"
                                                                               FontSize="11"
                                                                               VerticalAlignment="Center"
                                                                               Margin="6,0,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>

                                        <!-- Picker + margin + add — single row -->
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"
                                                        Margin="0,0,10,0">
                                                <TextBlock Text="Select organ"
                                                           Style="{StaticResource SfrtFieldLabel}"/>
                                                <ComboBox x:Name="OarPicker"
                                                          Style="{StaticResource SfrtComboBox}"
                                                          ItemsSource="{Binding OarStructures}"
                                                          SelectedIndex="{Binding SelectedOar, Mode=TwoWay}"
                                                          ToolTip="Pick an organ to add"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Margin="0,0,10,0">
                                                <TextBlock Text="OAR margin (mm)"
                                                           Style="{StaticResource SfrtFieldLabel}"/>
                                                <TextBox x:Name="OarMargin"
                                                         Style="{StaticResource SfrtTextBox}"
                                                         Text="{Binding OarMargin, UpdateSourceTrigger=LostFocus}"/>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource SfrtPrimaryButton}"
                                                    VerticalAlignment="Bottom"
                                                    Click="AddRoi">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconPlus}"
                                                          Stroke="White"
                                                          StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round"
                                                          Fill="Transparent"
                                                          Width="12"
                                                          Height="12"
                                                          VerticalAlignment="Center"/>
                                                    <TextBlock Text="Add"
                                                               Margin="8,0,0,0"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- ════ Plan setup ════ -->
                        <Border Grid.Row="2"
                                Style="{StaticResource SfrtSection}"
                                Margin="0,12,0,0">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Top"
                                        Style="{StaticResource SfrtSectionHeader}">
                                    <StackPanel>
                                        <TextBlock Text="Plan setup"
                                                   Style="{StaticResource SfrtSectionTitle}"/>
                                        <TextBlock Text="Machine, energy, geometry"
                                                   Style="{StaticResource SfrtSectionSub}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SfrtSectionBody}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,8,0">
                                            <TextBlock Text="Machine"
                                                       Style="{StaticResource SfrtFieldLabel}"/>
                                            <ComboBox x:Name="MachineIdComboBox"
                                                      Style="{StaticResource SfrtComboBox}"
                                                      ItemsSource="{Binding MachineDisplayNames}"
                                                      SelectedIndex="{Binding SelectedMachineId}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    Margin="4,0,4,0">
                                            <TextBlock Text="Energy"
                                                       Style="{StaticResource SfrtFieldLabel}"/>
                                            <ComboBox x:Name="BeamEnergyComboBox"
                                                      Style="{StaticResource SfrtComboBox}"
                                                      ItemsSource="{Binding EnergyList}"
                                                      SelectedIndex="{Binding SelectedEnergy}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    Margin="4,0,4,0">
                                            <TextBlock Text="Protocol"
                                                       Style="{StaticResource SfrtFieldLabel}"/>
                                            <ComboBox x:Name="PresetTemplateComboBox"
                                                      Style="{StaticResource SfrtComboBox}"
                                                      ItemsSource="{Binding PresetTemplates}"
                                                      SelectedIndex="{Binding SelectedPresetTemplate}"
                                                      SelectionChanged="PresetTemplate_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3"
                                                    Margin="4,0,4,0">
                                            <TextBlock Text="Sphere diameter"
                                                       Style="{StaticResource SfrtFieldLabel}"/>
                                            <ComboBox x:Name="SphereSizeComboBox"
                                                      Style="{StaticResource SfrtComboBox}"
                                                      ItemsSource="{Binding SphereSize}"
                                                      SelectedIndex="{Binding SelectedSphereSize}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4"
                                                    Margin="4,0,8,0">
                                            <TextBlock Text="Lattice spacing (cm)"
                                                       Style="{StaticResource SfrtFieldLabel}"/>
                                            <TextBox Style="{StaticResource SfrtTextBox}"
                                                     Text="{Binding LatticeSpacingCm, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="5"
                                                    Margin="0,0,0,0"
                                                    VerticalAlignment="Top">
                                            <TextBlock Text="Couch kick"
                                                       Style="{StaticResource SfrtFieldLabel}"/>
                                            <Border Height="36"
                                                    CornerRadius="8"
                                                    Background="{StaticResource SfrtSurface2}"
                                                    BorderBrush="{StaticResource SfrtBorderHi}"
                                                    BorderThickness="1"
                                                    Padding="12,0">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <ToggleButton Style="{StaticResource SfrtSwitch}"
                                                                  IsChecked="{Binding CouchKick}"
                                                                  VerticalAlignment="Center"/>
                                                    <TextBlock Text="Allow"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource SfrtText}"
                                                               FontSize="12"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DockPanel>
                        </Border>

                        <!-- ════ Rotation search ════ -->
                        <Border Grid.Row="3"
                                Style="{StaticResource SfrtSection}"
                                Margin="0,12,0,0">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Top"
                                        Style="{StaticResource SfrtSectionHeader}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Rotation search"
                                                       Style="{StaticResource SfrtSectionTitle}"/>
                                            <TextBlock Text="Find the lattice orientation that best fits the target while protecting OARs"
                                                       Style="{StaticResource SfrtSectionSub}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource SfrtGhostButton}"
                                                Height="30"
                                                Padding="10,0"
                                                Click="OpenAdvancedDrawer_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconSliders}"
                                                      Stroke="{StaticResource SfrtTextMid}"
                                                      StrokeThickness="1.4"
                                                      Fill="Transparent"
                                                      Width="14"
                                                      Height="14"
                                                      VerticalAlignment="Center"/>
                                                <TextBlock Text="Advanced parameters"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource SfrtSectionBody}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <ToggleButton Grid.Column="0"
                                                      Margin="0,0,6,0"
                                                      Style="{StaticResource SfrtToggleCard}"
                                                      IsChecked="{Binding EnableRotation}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton Grid.Column="0"
                                                              Style="{StaticResource SfrtSwitch}"
                                                              IsHitTestVisible="False"
                                                              IsChecked="{Binding EnableRotation}"
                                                              VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1"
                                                            Margin="12,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="Enable rotation search"
                                                               Foreground="{StaticResource SfrtText}"
                                                               FontSize="13"/>
                                                    <TextBlock Text="Two-pass orientation sweep"
                                                               Foreground="{StaticResource SfrtTextDim}"
                                                               FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </ToggleButton>

                                        <ToggleButton Grid.Column="1"
                                                      Margin="6,0,0,0"
                                                      Style="{StaticResource SfrtToggleCard}"
                                                      IsChecked="{Binding IndividualTuningStructures}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ToggleButton Grid.Column="0"
                                                              Style="{StaticResource SfrtSwitch}"
                                                              IsHitTestVisible="False"
                                                              IsChecked="{Binding IndividualTuningStructures}"
                                                              VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1"
                                                            Margin="12,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="Per-sphere tuning structures"
                                                               Foreground="{StaticResource SfrtText}"
                                                               FontSize="13"/>
                                                    <TextBlock Text="Create individual optimization handles"
                                                               Foreground="{StaticResource SfrtTextDim}"
                                                               FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </ToggleButton>
                                    </Grid>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- ─── RIGHT: Preview side panel ──────────────────────── -->
                <Border x:Name="PreviewPanel"
                        Grid.Column="1"
                        Visibility="Collapsed"
                        Background="{StaticResource SfrtSurface0}"
                        BorderBrush="{StaticResource SfrtBorderHi}"
                        BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0"
                                    Padding="20,14"
                                    BorderBrush="{StaticResource SfrtBorderLo}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Data="{StaticResource IconSphere}"
                                          Stroke="{StaticResource SfrtAccent}"
                                          StrokeThickness="1.3"
                                          Fill="Transparent"
                                          Width="16"
                                          Height="16"
                                          VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="3D preview"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource SfrtText}"/>
                                        <TextBlock Text="Live transform — not applied"
                                                   FontSize="11"
                                                   Foreground="{StaticResource SfrtTextDim}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            x:Name="HidePreviewBtn"
                                            Height="32"
                                            Padding="12,0"
                                            Background="{StaticResource SfrtAccentTint}"
                                            BorderBrush="{StaticResource SfrtAccent}"
                                            Foreground="{StaticResource SfrtAccentHi}"
                                            Style="{StaticResource SfrtButtonBase}"
                                            Click="HidePreview_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconEyeOff}"
                                                  Stroke="{StaticResource SfrtAccentHi}"
                                                  StrokeThickness="1.3"
                                                  Fill="Transparent"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="Hide 3D preview"
                                                       Margin="8,0,8,0"
                                                       Foreground="{StaticResource SfrtAccentHi}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"/>
                                            <Path Data="{StaticResource IconChevron}"
                                                  Stroke="{StaticResource SfrtAccentHi}"
                                                  StrokeThickness="1.5"
                                                  Fill="Transparent"
                                                  Width="10"
                                                  Height="10"
                                                  VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Status row -->
                            <Border Grid.Row="1"
                                    Padding="20,12"
                                    BorderBrush="{StaticResource SfrtBorderLo}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Style="{StaticResource SfrtPillOk}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6"
                                                     Height="6"
                                                     Fill="{StaticResource SfrtOk}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0"/>
                                            <TextBlock x:Name="PreviewStatsText"
                                                       Text="Preview ready"
                                                       Style="{StaticResource SfrtPillTextOk}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1"
                                            Style="{StaticResource SfrtPillAccent}"
                                            Margin="8,0,0,0">
                                        <TextBlock Style="{StaticResource SfrtPillTextAccent}">
                                        <Run Text="{Binding HotSphereCount, Mode=OneWay}"/>
                                        <Run Text=" spheres"/>
                                        </TextBlock>
                                    </Border>
                                    <Button Grid.Column="3"
                                            Style="{StaticResource SfrtGhostButton}"
                                            Height="28"
                                            Padding="10,0"
                                            Click="ResetGeometry_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconRefresh}"
                                                  Stroke="{StaticResource SfrtTextMid}"
                                                  StrokeThickness="1.4"
                                                  Fill="Transparent"
                                                  Width="14"
                                                  Height="14"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="Reset"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Preview action row (Preview 3D / Refine) -->
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        Margin="20,12,20,0">
                                <Button Style="{StaticResource SfrtSecondaryButton}"
                                        Click="Preview3D_Click"
                                        Padding="14,0"
                                        Height="32">
                                    <TextBlock Text="Preview 3D"
                                               VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SfrtSecondaryButton}"
                                        Margin="8,0,0,0"
                                        Click="RefineGenerate_Click"
                                        Padding="14,0"
                                        Height="32">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconRefresh}"
                                              Stroke="{StaticResource SfrtText}"
                                              StrokeThickness="1.4"
                                              Fill="Transparent"
                                              Width="13"
                                              Height="13"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="Refine preview"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Render frame containing the Viewport3D -->
                            <Border Grid.Row="3"
                                    Margin="20,12,20,0"
                                    CornerRadius="12"
                                    BorderBrush="{StaticResource SfrtBorderLo}"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    Height="290">
                                <Border.Background>
                                    <RadialGradientBrush Center="0.5,0.5"
                                                         RadiusX="0.7"
                                                         RadiusY="0.7">
                                        <GradientStop Color="#FF14202E"
                                                      Offset="0"/>
                                        <GradientStop Color="#FF0A1018"
                                                      Offset="1"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Viewport3D x:Name="PreviewViewport"
                                                ClipToBounds="True"
                                                MouseDown="PreviewViewport_MouseDown"
                                                MouseMove="PreviewViewport_MouseMove"
                                                MouseUp="PreviewViewport_MouseUp"
                                                MouseWheel="PreviewViewport_MouseWheel">
                                        <Viewport3D.Camera>
                                            <PerspectiveCamera x:Name="PreviewCamera"
                                                               FieldOfView="45"
                                                               Position="300,300,300"
                                                               LookDirection="-300,-300,-300"
                                                               UpDirection="0,0,1"/>
                                        </Viewport3D.Camera>
                                        <ModelVisual3D>
                                            <ModelVisual3D.Content>
                                                <Model3DGroup x:Name="PreviewSceneRoot">
                                                    <AmbientLight Color="#505050"/>
                                                    <DirectionalLight Color="#FFFFFF"
                                                                      Direction="-0.5,-0.6,-1"/>
                                                </Model3DGroup>
                                            </ModelVisual3D.Content>
                                        </ModelVisual3D>
                                    </Viewport3D>
                                </Grid>
                            </Border>

                            <!-- SHIFT sliders -->
                            <StackPanel Grid.Row="4"
                                        Margin="20,16,20,0">
                                <TextBlock Text="SHIFT (mm)"
                                           Style="{StaticResource SfrtGroupLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,8,0">
                                        <DockPanel>
                                            <TextBlock Text="X"
                                                       DockPanel.Dock="Left"
                                                       Style="{StaticResource SfrtFieldLabel}"
                                                       Margin="0"/>
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <TextBox Style="{StaticResource SfrtTextBox}"
                                                         Width="52"
                                                         Height="22"
                                                         Padding="4,0"
                                                         FontSize="12"
                                                         HorizontalContentAlignment="Right"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding ShiftX, Mode=TwoWay, StringFormat={}{0:F1}, UpdateSourceTrigger=LostFocus}"
                                                         KeyDown="ShiftBox_KeyDown"
                                                         LostFocus="ShiftBox_LostFocus"/>
                                                <TextBlock Text="mm"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource SfrtText}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Slider Style="{StaticResource SfrtSlider}"
                                                Minimum="{Binding PreviewShiftXMinimum}"
                                                Maximum="{Binding PreviewShiftXMaximum}"
                                                Value="{Binding ShiftX, Mode=TwoWay}"
                                                ValueChanged="PreviewSlider_ValueChanged"/>
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Left"
                                                       Foreground="{StaticResource SfrtTextFaint}"
                                                       FontSize="10"
                                                       Text="{Binding PreviewShiftXMinimum, StringFormat={}{0:F1}}"/>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Foreground="{StaticResource SfrtTextFaint}"
                                                       FontSize="10"
                                                       Text="{Binding PreviewShiftXMaximum, StringFormat={}{0:F1}}"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Margin="4,0,4,0">
                                        <DockPanel>
                                            <TextBlock Text="Y"
                                                       DockPanel.Dock="Left"
                                                       Style="{StaticResource SfrtFieldLabel}"
                                                       Margin="0"/>
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <TextBox Style="{StaticResource SfrtTextBox}"
                                                         Width="52"
                                                         Height="22"
                                                         Padding="4,0"
                                                         FontSize="12"
                                                         HorizontalContentAlignment="Right"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding ShiftY, Mode=TwoWay, StringFormat={}{0:F1}, UpdateSourceTrigger=LostFocus}"
                                                         KeyDown="ShiftBox_KeyDown"
                                                         LostFocus="ShiftBox_LostFocus"/>
                                                <TextBlock Text="mm"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource SfrtText}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Slider Style="{StaticResource SfrtSlider}"
                                                Minimum="{Binding PreviewShiftYMinimum}"
                                                Maximum="{Binding PreviewShiftYMaximum}"
                                                Value="{Binding ShiftY, Mode=TwoWay}"
                                                ValueChanged="PreviewSlider_ValueChanged"/>
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Left"
                                                       Foreground="{StaticResource SfrtTextFaint}"
                                                       FontSize="10"
                                                       Text="{Binding PreviewShiftYMinimum, StringFormat={}{0:F1}}"/>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Foreground="{StaticResource SfrtTextFaint}"
                                                       FontSize="10"
                                                       Text="{Binding PreviewShiftYMaximum, StringFormat={}{0:F1}}"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Margin="8,0,0,0">
                                        <DockPanel>
                                            <TextBlock Text="Z"
                                                       DockPanel.Dock="Left"
                                                       Style="{StaticResource SfrtFieldLabel}"
                                                       Margin="0"/>
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <TextBox Style="{StaticResource SfrtTextBox}"
                                                         Width="52"
                                                         Height="22"
                                                         Padding="4,0"
                                                         FontSize="12"
                                                         HorizontalContentAlignment="Right"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding ShiftZ, Mode=TwoWay, StringFormat={}{0:F1}, UpdateSourceTrigger=LostFocus}"
                                                         KeyDown="ShiftBox_KeyDown"
                                                         LostFocus="ShiftBox_LostFocus"/>
                                                <TextBlock Text="mm"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource SfrtText}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Slider Style="{StaticResource SfrtSlider}"
                                                Minimum="{Binding PreviewShiftZMinimum}"
                                                Maximum="{Binding PreviewShiftZMaximum}"
                                                Value="{Binding ShiftZ, Mode=TwoWay}"
                                                ValueChanged="PreviewSlider_ValueChanged"/>
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Left"
                                                       Foreground="{StaticResource SfrtTextFaint}"
                                                       FontSize="10"
                                                       Text="{Binding PreviewShiftZMinimum, StringFormat={}{0:F1}}"/>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Foreground="{StaticResource SfrtTextFaint}"
                                                       FontSize="10"
                                                       Text="{Binding PreviewShiftZMaximum, StringFormat={}{0:F1}}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- ROTATION sliders -->
                            <StackPanel Grid.Row="5"
                                        Margin="20,16,20,0"
                                        VerticalAlignment="Top">
                                <TextBlock Text="ROTATION (°)"
                                           Style="{StaticResource SfrtGroupLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,8,0">
                                        <DockPanel>
                                            <TextBlock Text="X"
                                                       DockPanel.Dock="Left"
                                                       Style="{StaticResource SfrtFieldLabel}"
                                                       Margin="0"/>
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <TextBox Style="{StaticResource SfrtTextBox}"
                                                         Width="52"
                                                         Height="22"
                                                         Padding="4,0"
                                                         FontSize="12"
                                                         HorizontalContentAlignment="Right"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding RotX, Mode=TwoWay, StringFormat={}{0:F1}, UpdateSourceTrigger=LostFocus}"
                                                         KeyDown="ShiftBox_KeyDown"
                                                         LostFocus="ShiftBox_LostFocus"/>
                                                <TextBlock Text="°"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource SfrtText}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Slider Style="{StaticResource SfrtSlider}"
                                                Minimum="-45"
                                                Maximum="45"
                                                Value="{Binding RotX, Mode=TwoWay}"
                                                ValueChanged="PreviewSlider_ValueChanged"/>
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Left"
                                                       Foreground="{StaticResource SfrtTextFaint}"
                                                       FontSize="10"
                                                       Text="-45"/>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Foreground="{StaticResource SfrtTextFaint}"
                                                       FontSize="10"
                                                       Text="45"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Margin="4,0,4,0">
                                        <DockPanel>
                                            <TextBlock Text="Y"
                                                       DockPanel.Dock="Left"
                                                       Style="{StaticResource SfrtFieldLabel}"
                                                       Margin="0"/>
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <TextBox Style="{StaticResource SfrtTextBox}"
                                                         Width="52"
                                                         Height="22"
                                                         Padding="4,0"
                                                         FontSize="12"
                                                         HorizontalContentAlignment="Right"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding RotY, Mode=TwoWay, StringFormat={}{0:F1}, UpdateSourceTrigger=LostFocus}"
                                                         KeyDown="ShiftBox_KeyDown"
                                                         LostFocus="ShiftBox_LostFocus"/>
                                                <TextBlock Text="°"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource SfrtText}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Slider Style="{StaticResource SfrtSlider}"
                                                Minimum="-45"
                                                Maximum="45"
                                                Value="{Binding RotY, Mode=TwoWay}"
                                                ValueChanged="PreviewSlider_ValueChanged"/>
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Left"
                                                       Foreground="{StaticResource SfrtTextFaint}"
                                                       FontSize="10"
                                                       Text="-45"/>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Foreground="{StaticResource SfrtTextFaint}"
                                                       FontSize="10"
                                                       Text="45"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Margin="8,0,0,0">
                                        <DockPanel>
                                            <TextBlock Text="Z"
                                                       DockPanel.Dock="Left"
                                                       Style="{StaticResource SfrtFieldLabel}"
                                                       Margin="0"/>
                                            <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <TextBox Style="{StaticResource SfrtTextBox}"
                                                         Width="52"
                                                         Height="22"
                                                         Padding="4,0"
                                                         FontSize="12"
                                                         HorizontalContentAlignment="Right"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding RotZ, Mode=TwoWay, StringFormat={}{0:F1}, UpdateSourceTrigger=LostFocus}"
                                                         KeyDown="ShiftBox_KeyDown"
                                                         LostFocus="ShiftBox_LostFocus"/>
                                                <TextBlock Text="°"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource SfrtText}"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Slider Style="{StaticResource SfrtSlider}"
                                                Minimum="-45"
                                                Maximum="45"
                                                Value="{Binding RotZ, Mode=TwoWay}"
                                                ValueChanged="PreviewSlider_ValueChanged"/>
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Left"
                                                       Foreground="{StaticResource SfrtTextFaint}"
                                                       FontSize="10"
                                                       Text="-45"/>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Foreground="{StaticResource SfrtTextFaint}"
                                                       FontSize="10"
                                                       Text="45"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Footer: use-transform checkbox -->
                            <Border Grid.Row="6"
                                    Padding="20,12,20,16"
                                    BorderBrush="{StaticResource SfrtBorderLo}"
                                    BorderThickness="0,1,0,0">
                                <CheckBox Style="{StaticResource SfrtCheckBox}"
                                          IsChecked="{Binding UseManualTransform, Mode=TwoWay}">
                                    <StackPanel>
                                        <TextBlock Text="Use preview transform for final"
                                                   Foreground="{StaticResource SfrtText}"
                                                   FontSize="13"/>
                                        <TextBlock Text="Apply current shift + rotation when generating spheres"
                                                   Foreground="{StaticResource SfrtTextDim}"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>

        <!-- ═══════════════════════════════════════════════════════════
             ADVANCED DRAWER overlay (left slide-in)
             ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="AdvancedDrawerOverlay"
              Visibility="Collapsed">
            <!-- Scrim -->
            <Border Background="{StaticResource SfrtScrim}"
                    MouseDown="CloseAdvancedDrawer_Click"/>
            <!-- Drawer panel -->
            <Border Width="440"
                    HorizontalAlignment="Left"
                    Background="{StaticResource SfrtSurface1}"
                    BorderBrush="{StaticResource SfrtBorderHi}"
                    BorderThickness="0,0,1,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30"
                                      ShadowDepth="0"
                                      Opacity="0.45"
                                      Direction="0"/>
                </Border.Effect>
                <DockPanel LastChildFill="True">
                    <!-- Header -->
                    <Border DockPanel.Dock="Top"
                            Padding="22,18"
                            BorderBrush="{StaticResource SfrtBorderLo}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="{StaticResource IconSliders}"
                                  Stroke="{StaticResource SfrtAccent}"
                                  StrokeThickness="1.4"
                                  Fill="Transparent"
                                  Width="16"
                                  Height="16"
                                  VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0">
                                <TextBlock Text="Rotation search"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SfrtText}"/>
                                <TextBlock Text="Advanced parameters"
                                           FontSize="11"
                                           Foreground="{StaticResource SfrtTextDim}"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Style="{StaticResource SfrtIconButton}"
                                    Width="30"
                                    Height="30"
                                    Click="CloseAdvancedDrawer_Click">
                                <Path Data="{StaticResource IconX}"
                                      Stroke="{StaticResource SfrtTextDim}"
                                      StrokeThickness="1.6"
                                      Fill="Transparent"
                                      Width="12"
                                      Height="12"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Footer -->
                    <Border DockPanel.Dock="Bottom"
                            Padding="22,14"
                            BorderBrush="{StaticResource SfrtBorderLo}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource SfrtGhostButton}"
                                    Height="32"
                                    Padding="12,0"
                                    Content="Reset defaults"
                                    Click="ResetAdvancedDefaults_Click"/>
                            <Button Grid.Column="2"
                                    Style="{StaticResource SfrtPrimaryButton}"
                                    Click="CloseAdvancedDrawer_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCheck}"
                                          Stroke="White"
                                          StrokeThickness="1.8"
                                          Fill="Transparent"
                                          Width="12"
                                          Height="12"
                                          VerticalAlignment="Center"/>
                                    <TextBlock Text="Apply"
                                               Margin="8,0,0,0"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Body -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="22">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource SfrtTextMid}"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16">
                                Two-pass orientation search. The coarse pass scans ± range at step intervals on each axis;
                                the fine pass refines the top K candidates with a smaller increment.
                            </TextBlock>

                            <TextBlock Text="COARSE PASS"
                                       Style="{StaticResource SfrtGroupLabel}"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,7,0">
                                    <TextBlock Text="Range (°)"
                                               Style="{StaticResource SfrtFieldLabel}"/>
                                    <TextBox Style="{StaticResource SfrtTextBox}"
                                             Text="{Binding RotationCoarseRange}"/>
                                    <TextBlock Text="± degrees on each axis"
                                               Foreground="{StaticResource SfrtTextFaint}"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Margin="7,0,0,0">
                                    <TextBlock Text="Step (°)"
                                               Style="{StaticResource SfrtFieldLabel}"/>
                                    <TextBox Style="{StaticResource SfrtTextBox}"
                                             Text="{Binding RotationCoarseStep}"/>
                                    <TextBlock Text="Increment per sample"
                                               Foreground="{StaticResource SfrtTextFaint}"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="FINE PASS"
                                       Style="{StaticResource SfrtGroupLabel}"/>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            Margin="0,0,7,0">
                                    <TextBlock Text="Range (°)"
                                               Style="{StaticResource SfrtFieldLabel}"/>
                                    <TextBox Style="{StaticResource SfrtTextBox}"
                                             Text="{Binding RotationFineRange}"/>
                                    <TextBlock Text="± degrees from each top candidate"
                                               Foreground="{StaticResource SfrtTextFaint}"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Margin="7,0,0,0">
                                    <TextBlock Text="Step (°)"
                                               Style="{StaticResource SfrtFieldLabel}"/>
                                    <TextBox Style="{StaticResource SfrtTextBox}"
                                             Text="{Binding RotationFineStep}"/>
                                    <TextBlock Text="Refinement increment"
                                               Foreground="{StaticResource SfrtTextFaint}"
                                               FontSize="11"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="CANDIDATES"
                                       Style="{StaticResource SfrtGroupLabel}"/>
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock Text="Top-K shifts"
                                           Style="{StaticResource SfrtFieldLabel}"/>
                                <TextBox Style="{StaticResource SfrtTextBox}"
                                         Text="{Binding RotationTopShifts, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Number of coarse winners to refine"
                                           Foreground="{StaticResource SfrtTextFaint}"
                                           FontSize="11"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Info banner -->
                            <Border Background="{StaticResource SfrtAccentTint}"
                                    BorderBrush="{StaticResource SfrtAccentSoft}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0"
                                          Data="{StaticResource IconInfo}"
                                          Stroke="{StaticResource SfrtAccentHi}"
                                          StrokeThickness="1.3"
                                          Fill="Transparent"
                                          Width="14"
                                          Height="14"
                                          VerticalAlignment="Top"
                                          Margin="0,2,0,0"/>
                                    <TextBlock Grid.Column="1"
                                               Margin="10,0,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource SfrtTextMid}"
                                               TextWrapping="Wrap"
                                               x:Name="SampleEstimateText">
                                        Sample estimate updates when the values above change.
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             LOG DRAWER overlay (right slide-in)
             ═══════════════════════════════════════════════════════════ -->
        <Grid x:Name="LogDrawerOverlay"
              Visibility="Collapsed">
            <!-- Scrim -->
            <Border Background="{StaticResource SfrtScrim}"
                    MouseDown="CloseLogDrawer_Click"/>
            <!-- Drawer panel -->
            <Border Width="520"
                    HorizontalAlignment="Right"
                    Background="{StaticResource SfrtSurface1}"
                    BorderBrush="{StaticResource SfrtBorderHi}"
                    BorderThickness="1,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30"
                                      ShadowDepth="0"
                                      Opacity="0.45"
                                      Direction="180"/>
                </Border.Effect>
                <DockPanel LastChildFill="True">
                    <!-- Header -->
                    <Border DockPanel.Dock="Top"
                            Padding="22,18"
                            BorderBrush="{StaticResource SfrtBorderLo}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="{StaticResource IconInfo}"
                                  Stroke="{StaticResource SfrtAccent}"
                                  StrokeThickness="1.4"
                                  Fill="Transparent"
                                  Width="16"
                                  Height="16"
                                  VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0">
                                <TextBlock Text="Logs"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SfrtText}"/>
                                <TextBlock Text="Full script output"
                                           FontSize="11"
                                           Foreground="{StaticResource SfrtTextDim}"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Style="{StaticResource SfrtIconButton}"
                                    Width="30"
                                    Height="30"
                                    Click="CloseLogDrawer_Click">
                                <Path Data="{StaticResource IconX}"
                                      Stroke="{StaticResource SfrtTextDim}"
                                      StrokeThickness="1.6"
                                      Fill="Transparent"
                                      Width="12"
                                      Height="12"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Footer -->
                    <Border DockPanel.Dock="Bottom"
                            Padding="22,14"
                            BorderBrush="{StaticResource SfrtBorderLo}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Style="{StaticResource SfrtGhostButton}"
                                    Height="32"
                                    Padding="12,0"
                                    Content="Clear"
                                    Click="ClearLogs_Click"/>
                            <Button Style="{StaticResource SfrtSecondaryButton}"
                                    Height="32"
                                    Padding="14,0"
                                    Margin="10,0,0,0"
                                    Content="Close"
                                    Click="CloseLogDrawer_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Body -->
                    <Border Margin="18"
                            CornerRadius="10"
                            Background="{StaticResource SfrtSurface0}"
                            BorderBrush="{StaticResource SfrtBorderLo}"
                            BorderThickness="1">
                        <TextBox x:Name="LogTextBox"
                                 Background="Transparent"
                                 Foreground="{StaticResource SfrtText}"
                                 FontFamily="{StaticResource SfrtMono}"
                                 FontSize="12"
                                 BorderThickness="0"
                                 Padding="14"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Text="{Binding Output, Mode=OneWay, TargetNullValue=' '}"/>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
